{
  "name": "Quizzler",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--privileged"],
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "userEnvProbe": "none",
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/quizzler"
  },
  "postCreateCommand": "uv sync --all-groups --frozen",
  "postStartCommand": "sh -c 'nohup uv run python -m backend >/tmp/quizzler-dev.log 2>&1 </dev/null &'",
  "forwardPorts": [5000, 9696],
  "portsAttributes": {
    "5000": {
      "label": "Quizzler",
      "onAutoForward": "openBrowser"
    },
    "9696": {
      "label": "Quizzler (Podman)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/quizzler/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "test_backend"
        ]
      }
    }
  }
}